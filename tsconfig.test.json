{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* @vitest/expect is not hoisted to node_modules/@vitest in pnpm strict mode.
     * This path alias is scoped to test-only typecheck (W-001 fix).
     * The symlink at .pnpm/node_modules/@vitest/expect is the peer-dedup layer;
     * it is version-free and survives vitest minor bumps within the same lockfile.
     * It is intentionally kept here (not in tsconfig.app.json) so the production
     * typecheck config carries no pnpm-internal path dependencies. */
    "paths": {
      "@/*": ["./src/*"],
      "@vitest/expect": ["./node_modules/.pnpm/node_modules/@vitest/expect"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/vitest-axe.d.ts",
    "src/test/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "exclude": [
    "src/api/generated",
    "node_modules"
  ]
}
